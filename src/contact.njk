          </div>
          <div class="contact-info__detail">
            <span class="contact-info__label">Office Phone</span>
            <a href="tel:+15550000000" class="contact-info__value">(555) 000-0000</a>
            <span class="contact-info__note">Mon – Fri, 8:00 AM – 5:00 PM CT</span>
          </div>
        </li>

        <li class="contact-info__item">
          <div class="contact-info__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 3H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z"/><line x1="12" y1="12" x2="12" y2="17"/><line x1="9.5" y1="14.5" x2="14.5" y2="14.5"/></svg>
          </div>
          <div class="contact-info__detail">
            <span class="contact-info__label">Fax</span>
            <span class="contact-info__value">(555) 000-0001</span>
            <span class="contact-info__note">Available 24/7 for document submissions</span>
          </div>
        </li>

        <li class="contact-info__item">
          <div class="contact-info__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="contact-info__detail">
            <span class="contact-info__label">Email</span>
            <a href="mailto:info@ghlsinc.com" class="contact-info__value">info@ghlsinc.com</a>
            <span class="contact-info__note">Best for non-urgent inquiries and documentation</span>
          </div>
        </li>

        <li class="contact-info__item">
          <div class="contact-info__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="contact-info__detail">
            <span class="contact-info__label">Office Address</span>
            <span class="contact-info__value">123 Commerce Drive<br>Suite 100<br>Anytown, TX 00000</span>
            <span class="contact-info__note">By appointment only</span>
          </div>
        </li>

      </ul>

      <div class="contact-info__hours-card">
        <h3 class="contact-info__hours-title">Business Hours</h3>
        <ul class="contact-info__hours-list">
          <li><span>Monday – Friday</span><span>8:00 AM – 5:00 PM CT</span></li>
          <li><span>Saturday</span><span>Closed</span></li>
          <li><span>Sunday</span><span>Closed</span></li>
        </ul>
        <p class="contact-info__hours-note">Fax and email submissions are accepted outside business hours and reviewed the next business day.</p>
      </div>
    </div>

    {# ── CONTACT FORM ── #}
    <div class="contact-form-wrap">
      <h2 class="contact-form-wrap__title">Send Us a Message</h2>
      <p class="contact-form-wrap__sub">Use the form below for general inquiries. For pricing, use our <a href="{{ '/request-quote/' | url }}">quote request form</a>.</p>

      <form
        action="https://formspree.io/f/YOUR_FORM_ID"
        method="POST"
        class="contact-form"
        novalidate
      >
        <div class="form-row form-row--2">
          <div class="form-group">
            <label class="form-label" for="c-name">Full Name <span aria-hidden="true">*</span></label>
            <input class="form-input" type="text" id="c-name" name="name" required autocomplete="name" placeholder="Jane Smith">
          </div>
          <div class="form-group">
            <label class="form-label" for="c-email">Email Address <span aria-hidden="true">*</span></label>
            <input class="form-input" type="email" id="c-email" name="email" required autocomplete="email" placeholder="jane@yourclinic.com">
          </div>
        </div>
        <div class="form-row form-row--2">
          <div class="form-group">
            <label class="form-label" for="c-phone">Phone Number</label>
            <input class="form-input" type="tel" id="c-phone" name="phone" autocomplete="tel" placeholder="(555) 000-0000">
          </div>
          <div class="form-group">
            <label class="form-label" for="c-org">Clinic / Organization</label>
            <input class="form-input" type="text" id="c-org" name="organization" placeholder="Your clinic name">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="c-subject">Subject <span aria-hidden="true">*</span></label>
          <select class="form-input form-select" id="c-subject" name="subject" required>
            <option value="" disabled selected>Select a topic…</option>
            <option>General Inquiry</option>
            <option>Product Question</option>
            <option>Order Status</option>
            <option>Compliance / Documentation</option>
            <option>Billing</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="c-message">Message <span aria-hidden="true">*</span></label>
          <textarea class="form-input form-textarea" id="c-message" name="message" rows="5" required placeholder="How can we help?"></textarea>
        </div>

        <input type="hidden" name="_subject" value="New Contact Message — GHLS Inc.">
        <input type="text" name="_gotcha" style="display:none">

        <div class="form-submit-row">
          <button type="submit" class="btn btn--primary btn--lg">Send Message</button>
          <p class="form-submit-row__note">We respond to all messages within one business day.</p>
        </div>

      </form>
    </div>

  </div>
</section>
