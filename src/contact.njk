{# ── CONTACT LAYOUT ───────────────────────────────────────── #}
<section class="section" aria-labelledby="contact-heading">
  <div class="container contact-layout">

    {# ── CONTACT INFO ── #}
    <div class="contact-info">
      <h2 class="contact-info__title" id="contact-heading">Contact Information</h2>
