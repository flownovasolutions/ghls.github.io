<footer class="site-footer" aria-label="Site footer">

  <div class="site-footer__body">
    <div class="container site-footer__inner">

      {# ── Brand col ── #}
      <div class="site-footer__brand">
        <a href="{{ '/' | url }}" class="site-footer__logo" aria-label="{{ site.name }} Home">
          <img src="/assets/images/logo.svg" alt="{{ site.name }}" width="120" height="34" loading="lazy" />
        </a>
        <p class="site-footer__tagline">
          Wholesale medical supplies for clinics —<br />
          FDA-compliant, fairly priced.
        </p>
        <div class="site-footer__contact-quick">
          <a href="tel:+15550000000" class="site-footer__contact-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            (555) 000-0000
          </a>
          <a href="mailto:info@ghlsinc.com" class="site-footer__contact-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            info@ghlsinc.com
          </a>
        </div>
        {% if site.social.linkedin %}
        <div class="site-footer__social">
          <a href="{{ site.social.linkedin }}" class="site-footer__social-link" aria-label="{{ site.name }} on LinkedIn" rel="noopener noreferrer" target="_blank">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.268c-.966 0-1.75-.784-1.75-1.75s.784-1.75 1.75-1.75 1.75.784 1.75 1.75-.784 1.75-1.75 1.75zm13.5 11.268h-3v-5.604c0-1.337-.026-3.059-1.865-3.059-1.866 0-2.152 1.457-2.152 2.963v5.7h-3v-10h2.881v1.367h.041c.401-.761 1.381-1.563 2.844-1.563 3.042 0 3.604 2.002 3.604 4.604v5.592z"/></svg>
          </a>
        </div>
        {% endif %}
      </div>

      {# ── Nav cols ── #}
      <nav class="site-footer__nav" aria-label="Footer Navigation">

        <div class="site-footer__nav-col">
          <h3 class="site-footer__nav-heading">Products</h3>
          <ul class="site-footer__nav-list" role="list">
            <li><a href="{{ '/products/' | url }}"                class="site-footer__nav-link">All Products</a></li>
            <li><a href="{{ '/products/womens-health/' | url }}"  class="site-footer__nav-link">Women's Health</a></li>
            <li><a href="{{ '/products/diagnostics/' | url }}"    class="site-footer__nav-link">Medical Diagnostics</a></li>
          </ul>
        </div>

        <div class="site-footer__nav-col">
          <h3 class="site-footer__nav-heading">Company</h3>
          <ul class="site-footer__nav-list" role="list">
            <li><a href="{{ '/about/' | url }}"   class="site-footer__nav-link">About GHLS</a></li>
            <li><a href="{{ '/faq/' | url }}"     class="site-footer__nav-link">FAQ</a></li>
          </ul>
        </div>

        <div class="site-footer__nav-col">
          <h3 class="site-footer__nav-heading">Work With Us</h3>
          <ul class="site-footer__nav-list" role="list">
            <li><a href="{{ '/request-quote/' | url }}" class="site-footer__nav-link">Request a Quote</a></li>
            <li><a href="{{ '/contact/' | url }}"       class="site-footer__nav-link">Contact Us</a></li>
          </ul>
        </div>

        <div class="site-footer__nav-col">
          <h3 class="site-footer__nav-heading">Office</h3>
          <address class="site-footer__address">
            <p>123 Commerce Drive<br />Suite 100<br />Anytown, TX 00000</p>
            <p>
              <a href="tel:+15550000000"     class="site-footer__nav-link">P: (555) 000-0000</a><br>
              <span class="site-footer__nav-link--plain">F: (555) 000-0001</span>
            </p>
            <p>Mon – Fri, 8 AM – 5 PM CT</p>
          </address>
        </div>

      </nav>
    </div>
  </div>

  {# ── Bottom bar ── #}
  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <p class="site-footer__copyright">
        &copy; {{ site.foundedYear }}{% if site.foundedYear != currentYear %}–{{ currentYear }}{% endif %}
        {{ site.name }}. All rights reserved.
      </p>
      <ul class="site-footer__legal" role="list">
        <li><a href="{{ '/privacy-policy/' | url }}">Privacy Policy</a></li>
        <li><a href="{{ '/terms-of-use/' | url }}">Terms of Use</a></li>
      </ul>
    </div>
  </div>

</footer>
