<footer class="site-footer">
  <div class="container site-footer__inner">

    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo" aria-label="{{ site.name }} Home">
        <img src="/assets/images/logo.svg" alt="{{ site.name }}" width="120" height="34" loading="lazy" />
      </a>
      <p class="site-footer__tagline">Your trusted wholesale partner<br />for medical supplies.</p>
      <div class="site-footer__social">
        {% if site.social.linkedin %}
          <a href="{{ site.social.linkedin }}" class="site-footer__social-link" aria-label="{{ site.name }} on LinkedIn" rel="noopener noreferrer" target="_blank">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.268c-.966 0-1.75-.784-1.75-1.75s.784-1.75 1.75-1.75 1.75.784 1.75 1.75-.784 1.75-1.75 1.75zm13.5 11.268h-3v-5.604c0-1.337-.026-3.059-1.865-3.059-1.866 0-2.152 1.457-2.152 2.963v5.7h-3v-10h2.881v1.367h.041c.401-.761 1.381-1.563 2.844-1.563 3.042 0 3.604 2.002 3.604 4.604v5.592z"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

    <nav class="site-footer__nav" aria-label="Footer Navigation">
      <div class="site-footer__nav-col">
        <h3 class="site-footer__nav-heading">Products</h3>
        <ul class="site-footer__nav-list" role="list">
          <li><a href="/products/ppe/"            class="site-footer__nav-link">PPE &amp; Protection</a></li>
          <li><a href="/products/diagnostics/"    class="site-footer__nav-link">Diagnostics</a></li>
          <li><a href="/products/surgical/"       class="site-footer__nav-link">Surgical Supplies</a></li>
          <li><a href="/products/wound-care/"     class="site-footer__nav-link">Wound Care</a></li>
          <li><a href="/products/rehabilitation/" class="site-footer__nav-link">Rehabilitation</a></li>
          <li><a href="/catalog/"                 class="site-footer__nav-link">Full Catalog</a></li>
        </ul>
      </div>
      <div class="site-footer__nav-col">
        <h3 class="site-footer__nav-heading">Company</h3>
        <ul class="site-footer__nav-list" role="list">
          <li><a href="/about/"       class="site-footer__nav-link">About Us</a></li>
          <li><a href="/about/#team"  class="site-footer__nav-link">Our Team</a></li>
          <li><a href="/careers/"     class="site-footer__nav-link">Careers</a></li>
          <li><a href="/news/"        class="site-footer__nav-link">News &amp; Updates</a></li>
        </ul>
      </div>
      <div class="site-footer__nav-col">
        <h3 class="site-footer__nav-heading">Support</h3>
        <ul class="site-footer__nav-list" role="list">
          <li><a href="/contact/"       class="site-footer__nav-link">Contact Us</a></li>
          <li><a href="/faq/"           class="site-footer__nav-link">FAQ</a></li>
          <li><a href="/shipping/"      class="site-footer__nav-link">Shipping &amp; Returns</a></li>
          <li><a href="/request-quote/" class="site-footer__nav-link">Request a Quote</a></li>
        </ul>
      </div>
      <div class="site-footer__nav-col">
        <h3 class="site-footer__nav-heading">Contact</h3>
        <address class="site-footer__address">
          <p>{{ site.address.street }}<br />{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</p>
          <p><a href="tel:{{ site.phone | replace(' ', '') }}" class="site-footer__nav-link">{{ site.phone }}</a></p>
          <p><a href="mailto:{{ site.email }}" class="site-footer__nav-link">{{ site.email }}</a></p>
        </address>
      </div>
    </nav>

  </div>

  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <p class="site-footer__copyright">
        &copy; {{ site.foundedYear }}{% if site.foundedYear != currentYear %}–{{ currentYear }}{% endif %}
        {{ site.name }}. All rights reserved.
      </p>
      <ul class="site-footer__legal" role="list">
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/terms-of-use/">Terms of Use</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
      </ul>
    </div>
  </div>
</footer>
