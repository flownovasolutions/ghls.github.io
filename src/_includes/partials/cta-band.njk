{# ============================================================
   cta-band.njk — Reusable CTA Banner
   Override before include:
     {% set ctaHeading        = "Custom heading" %}
     {% set ctaSubheading     = "Custom sub" %}
     {% set ctaPrimaryLabel   = "Button Label" %}
     {% set ctaPrimaryHref    = "/url/" %}
     {% set ctaSecondaryLabel = "Button Label" %}
     {% set ctaSecondaryHref  = "/url/" %}
============================================================ #}

{% set _heading        = ctaHeading        or "Ready to streamline your medical supply chain?" %}
{% set _sub            = ctaSubheading     or "Talk to a GHLS specialist today and get a customized wholesale quote within 24 hours." %}
{% set _primaryLabel   = ctaPrimaryLabel   or "Request a Quote" %}
{% set _primaryHref    = ctaPrimaryHref    or "/request-quote/" %}
{% set _secondaryLabel = ctaSecondaryLabel or "Contact Us" %}
{% set _secondaryHref  = ctaSecondaryHref  or "/contact/" %}

<section class="cta-band" aria-labelledby="cta-band-heading">
  <div class="container cta-band__inner">
    <div class="cta-band__content">
      <h2 class="cta-band__heading" id="cta-band-heading">{{ _heading }}</h2>
      <p class="cta-band__sub">{{ _sub }}</p>
    </div>
    <div class="cta-band__actions">
      <a href="{{ _primaryHref }}"   class="btn btn--white         btn--lg">{{ _primaryLabel }}</a>
      <a href="{{ _secondaryHref }}" class="btn btn--outline-white btn--lg">{{ _secondaryLabel }}</a>
    </div>
  </div>
</section>
